root = true

[*.cs]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# C# naming conventions
# Info severity: dotnet format --severity info (the CI gate) only reports
# rules at info level or above, so naming/style rules below info would never
# be enforced. AGENTS.md §1.5 declares these rules CI-enforced. Note: naming
# rules are fix-only in dotnet format and are not reported by
# --verify-no-changes; the style rules below are enforced by the gate.
dotnet_naming_rule.private_fields_should_be_camel_case.severity = info
dotnet_naming_rule.private_fields_should_be_camel_case.symbols = private_fields
dotnet_naming_rule.private_fields_should_be_camel_case.style = camel_case_underscore

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_fields.required_modifiers =

dotnet_naming_style.camel_case_underscore.required_prefix = _
dotnet_naming_style.camel_case_underscore.capitalization = camel_case

# C# code style
csharp_style_var_for_built_in_types = true:info
csharp_style_var_when_type_is_apparent = true:info
csharp_style_expression_bodied_methods = when_on_single_line:info
csharp_style_expression_bodied_properties = true:info
csharp_style_namespace_declarations = file_scoped:info
csharp_style_prefer_switch_expression = true:info
csharp_style_prefer_pattern_matching = true:info
csharp_style_prefer_not_pattern = true:info

# Null checking style
# CA1062 (validate public parameters) is enforced at error level in production
# code; only test projects and test support are exempt (parameters are supplied
# by the framework there — see the test-project section below).
# The rule is no longer part of the default recommended set on the .NET 10 SDK,
# so it must be enabled explicitly.
dotnet_diagnostic.CA1062.severity = error

# Test projects and test support: flat namespace for cross-directory type access.
# Intentional design — see docs/Origo.Core.Tests/META-TEST.zh.md §测试命名空间约定
# (and the recorded Integration.Tests Runner/TestSupport deviation there).
# CA1062 (validate public parameters): suppressed — parameters are supplied by the framework.
[{Origo.Core.Tests,Origo.GodotAdapter.Tests,Origo.GodotAdapter.Integration.Tests,Origo.ConsoleBridge.Tests,Origo.SourceGeneration.Tests,Origo.TestSupport}/**/*.cs]
dotnet_diagnostic.IDE0130.severity = none
dotnet_diagnostic.CA1062.severity = none

# tools/DocSyncTool.Tests is exempt for the same reasons (flat namespaces and
# framework-supplied parameters), but lives under tools/ so it needs its own
# glob — EditorConfig sections match paths relative to this file's directory.
[tools/DocSyncTool.Tests/**/*.cs]
dotnet_diagnostic.IDE0130.severity = none
dotnet_diagnostic.CA1062.severity = none

