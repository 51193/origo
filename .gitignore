# .NET
bin/
obj/
/packages/
*.user
*.suo

# Repository-local .NET SDK and CLI/NuGet caches installed or refreshed by
# scripts/bash/install-dotnet.sh. The ./dotnet wrapper script at the repository
# root is tracked.
/.dotnet/
/.dotnet-cli-home/
/.nuget/

# JetBrains Rider / IntelliJ
.idea/
_ReSharper.Caches/
riderModule.iml

# Visual Studio
.vs/

# Godot
.godot/

# Godot UID files are generated artifacts and are not tracked.
*.uid

# Build output
publish/

# Coverlet (local / CI artifact)
coverage.cobertura.xml
TestResults/

# Python bytecode caches written by scripts/python/*.py and the script self-tests
__pycache__/
*.pyc

# OS
.DS_Store
Thumbs.db
# Godot binary cache (downloaded by scripts/bash/download-godot.sh)
.godot_binary/

# Godot user-data home used when the real HOME/XDG directories are read-only
.godot-home/

artifacts/

# Local agent work buffer (untracked by design; see AGENTS.md, local agent work buffer)
_origo_local/

# docs/agents/ is tracked; root content directories such as assets/ have no
# ignore rule.

# Local scratch work
/.scratch/
