# .NET
bin/
obj/
/packages/
*.user
*.suo

# Repository-local .NET SDK and CLI/NuGet caches installed by
# scripts/install-dotnet.sh when the default user install roots are not
# writable. The ./dotnet wrapper script at the repository root is tracked.
/.dotnet/
/.dotnet-cli-home/
/.nuget/

# JetBrains Rider / IntelliJ
.idea/
_ReSharper.Caches/
riderModule.iml

# Godot
.godot/

# Godot UID files are generated artifacts and are not tracked.
*.uid

# Build output
publish/

# Coverlet (local / CI artifact)
coverage.cobertura.xml
coverage.xml
TestResults/

# OS
.DS_Store
Thumbs.db
# Godot binary cache (downloaded by scripts/download-godot.sh)
.godot_binary/

# Godot user-data home used when the real HOME/XDG directories are read-only
.godot-home/

artifacts/

# Rider IDE
*.cs.uid

