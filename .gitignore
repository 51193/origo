# .NET
bin/
obj/
/packages/
*.user
*.suo

# Repository-local .NET SDK and CLI/NuGet caches installed by
# scripts/install-dotnet.sh when the default user install roots are not
# writable. The ./dotnet wrapper script at the repository root is tracked.
/.dotnet/
/.dotnet-cli-home/
/.nuget/

# JetBrains Rider / IntelliJ
.idea/
_ReSharper.Caches/
riderModule.iml

# Visual Studio
.vs/

# Godot
.godot/

# Godot UID files are generated artifacts and are not tracked.
*.uid

# Build output
publish/

# Coverlet (local / CI artifact)
coverage.cobertura.xml
TestResults/

# Python bytecode caches written by scripts/*.py and the script self-tests
__pycache__/
*.pyc

# OS
.DS_Store
Thumbs.db
# Godot binary cache (downloaded by scripts/download-godot.sh)
.godot_binary/

# Godot user-data home used when the real HOME/XDG directories are read-only
.godot-home/

artifacts/

# Local agent work buffer (untracked by design; see AGENTS.md, local agent work buffer)
_origo_local/

# A "local learning workspace" ignore block (/MISSION.md, /RESOURCES.md,
# /assets/, /lessons/, /reference/) was unused template residue: no script,
# document, or tracked file references those paths, and /assets/ would silently
# untrack a future root assets directory. The patterns are intentionally gone.

# Matt Pocock agent configuration under docs/agents/ is tracked normally
# (see docs/agents/README.en.md); no re-include rule is needed.

# Local scratch work
/.scratch/
