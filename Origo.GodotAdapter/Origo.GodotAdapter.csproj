<Project Sdk="Godot.NET.Sdk/4.7.2">

    <PropertyGroup>
        <EnableDynamicLoading>true</EnableDynamicLoading>
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
        <!-- Package metadata must not repeat the Godot.NET.Sdk pin: the Sdk
             attribute above is the single authority, and versions written here
             go stale on a bump with no gate. Keep only version-free tags. -->
        <Description>Origo Godot 4 Adapter — bootstrap and runtime integration for Origo.Core, built against the Godot .NET SDK pinned by this project.</Description>
        <PackageTags>godot;godot-4;game;framework;csharp;origo;adapter;snd;entity</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <GodotDisabledSourceGenerators>GodotPluginsInitializer</GodotDisabledSourceGenerators>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Origo.Core\Origo.Core.csproj"/>
        <ProjectReference Include="..\Origo.Core.Kernel\Origo.Core.Kernel.csproj" PrivateAssets="all"/>
        <ProjectReference Include="..\Origo.SourceGeneration\Origo.SourceGeneration.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Origo.GodotAdapter.Tests"/>
        <InternalsVisibleTo Include="Origo.GodotAdapter.Integration.Tests"/>
    </ItemGroup>

</Project>

