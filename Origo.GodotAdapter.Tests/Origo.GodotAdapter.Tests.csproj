<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <RollForward>LatestMajor</RollForward>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <UseAppHost>true</UseAppHost>
        <!-- Test methods use underscore naming convention by design. -->
        <!-- CA1707: test method underscores; CA1859: intentional interface-typed variables in architecture tests -->
        <NoWarn>$(NoWarn);CA1707;CA1859</NoWarn>
    </PropertyGroup>

    <PropertyGroup>
        <CollectCoverage>true</CollectCoverage>
        <CoverletOutputFormat>cobertura</CoverletOutputFormat>
        <Include>[Origo.GodotAdapter]*</Include>
        <!-- Engine-bound files are exempt with documented technical reasons
             (every statement is a Godot native call; the xUnit host has no engine,
             and calling any Godot API there SIGSEGVs the test process):
             - GodotSndEntity/GodotSndManager/OrigoAutoHost/OrigoDefaultEntry*:
               Godot Node subclasses; node creation, scene-tree and GD.* calls
               are unreachable outside the engine. Their orchestration logic is
               extracted into SndEntityCollection (pure C#, tested) and the Core
               session pipeline (tested in Origo.Core.Tests); the engine bridge
               itself is exercised by Origo.GodotAdapter.Integration.Tests.
             - FileSystem/*: every member body is a FileAccess/DirAccess call;
               static Godot APIs cannot be mocked or invoked headlessly.
             - Snd/GodotNodeHandle, Snd/GodotPackedSceneNodeFactory: constructed
               from live Godot nodes/resources; ResourceLoader requires the engine.
             - Console/CameraViewCommandHandler: ExecuteCore's first statement is
               Engine.GetMainLoop(), so no error path is reachable headlessly.
             - Godot source-generator products (.godot/.../Godot.SourceGenerators/)
               are tool-generated, unannotated, and untestable outside the engine.
             TypedData.g.cs (Origo.SourceGeneration) is NOT excluded: it is
             exercised heavily by the adapter tests. -->
        <ExcludeByFile>**/Godot.SourceGenerators/**,**/Snd/GodotSndManager.cs,**/Snd/GodotSndEntity.cs,**/Snd/GodotNodeHandle.cs,**/Snd/GodotPackedSceneNodeFactory.cs,**/FileSystem/GodotFileOperations.cs,**/FileSystem/GodotDirectoryOperations.cs,**/FileSystem/GodotFileSystem.cs,**/Bootstrap/OrigoAutoHost.cs,**/Bootstrap/OrigoDefaultEntry.cs,**/Bootstrap/OrigoDefaultEntry.Bootstrap.cs,**/Console/CameraViewCommandHandler.cs</ExcludeByFile>
        <Threshold>90</Threshold>
        <ThresholdType>line</ThresholdType>
        <ThresholdStat>total</ThresholdStat>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.msbuild">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.NET.Test.Sdk"/>
        <PackageReference Include="xunit.v3"/>
        <PackageReference Include="xunit.runner.visualstudio">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Origo.GodotAdapter\Origo.GodotAdapter.csproj"/>
        <ProjectReference Include="..\Origo.TestSupport\Origo.TestSupport.csproj"/>
    </ItemGroup>

</Project>
