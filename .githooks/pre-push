#!/usr/bin/env bash
# Lint every branch update before Git uploads objects to the remote.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

REMOTE_NAME="${1:-origin}"
BASE_REF="refs/remotes/$REMOTE_NAME/main"
ZERO_SHA="0000000000000000000000000000000000000000"

if ! git rev-parse --verify --quiet "$BASE_REF^{commit}" >/dev/null; then
  echo "ERROR: $BASE_REF is unavailable; fetch the remote base first:" >&2
  echo "  git fetch --no-tags $REMOTE_NAME main" >&2
  exit 2
fi

CHECKED=0
while read -r local_ref local_sha _remote_ref _remote_sha; do
  if [[ "$local_sha" == "$ZERO_SHA" || "$local_ref" != refs/heads/* ]]; then
    continue
  fi

  base_sha="$(git merge-base "$BASE_REF" "$local_sha")"
  if [[ -z "$base_sha" ]]; then
    echo "ERROR: $local_ref has no merge base with $BASE_REF." >&2
    exit 2
  fi

  bash scripts/lint-commits.sh "$base_sha" "$local_sha"
  CHECKED=1
done

if [[ $CHECKED -eq 0 ]]; then
  echo "Commit lint: no branch updates to check."
fi
