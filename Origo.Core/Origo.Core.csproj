<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Description>Origo Core — a lightweight, platform-agnostic C# game framework using the SND (Strategy-Node-Data) model.</Description>
        <PackageTags>game;framework;csharp;snd;entity;strategy;dotnet;origo</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <!-- Origo.GodotAdapter needs internal access to ObserverTopology, IObserverTopologyHost,
             ISndEntityRawSubscription, and SndWorld.StrategyPool. These form a cross-module
             collaboration chain (per-scene-host observer topology pattern) documented in
             docs/Origo.Core/Snd/Strategy/ and docs/Origo.Core/Snd/Scene/.
             This is deliberate co-design, not a backdoor — see AGENTS.md §1.3. -->
        <InternalsVisibleTo Include="Origo.GodotAdapter"/>
        <!-- Test projects: standard InternalsVisibleTo for unit/integration test access. -->
        <InternalsVisibleTo Include="Origo.Core.Tests"/>
        <InternalsVisibleTo Include="Origo.GodotAdapter.Tests"/>
        <InternalsVisibleTo Include="Origo.GodotAdapter.Integration.Tests"/>
        <InternalsVisibleTo Include="Origo.SourceGeneration.Tests"/>
        <!-- Test support library (shared test doubles/helpers) reaches the
             framework-internal test pipeline via InternalsVisibleTo. -->
        <InternalsVisibleTo Include="Origo.TestSupport"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Origo.SourceGeneration\Origo.SourceGeneration.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"/>
    </ItemGroup>

    <Target Name="IncludeSourceGeneratorInPackage" BeforeTargets="_GetPackageFiles">
        <ItemGroup>
            <_PackageFiles Include="..\Origo.SourceGeneration\bin\$(Configuration)\netstandard2.0\Origo.SourceGeneration.dll">
                <PackagePath>analyzers/dotnet/cs</PackagePath>
            </_PackageFiles>
            <!-- Runtime dependency of the generator (official HashCode polyfill);
                 analyzers are loaded by file reference, so the dependency must
                 ship next to the generator dll. -->
            <_PackageFiles Include="..\Origo.SourceGeneration\bin\$(Configuration)\netstandard2.0\Microsoft.Bcl.HashCode.dll">
                <PackagePath>analyzers/dotnet/cs</PackagePath>
            </_PackageFiles>
        </ItemGroup>
    </Target>

</Project>
