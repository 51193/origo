<Project Sdk="Microsoft.NET.Sdk">

    <!--
      Fresh-package consumer fixture for the shell-only ConsoleBridge package.
      It must never contain a ProjectReference to the Origo repository; the
      package-consumer smoke script restores it from a local feed.
      OrigoShellPackageVersion is supplied on the restore/build command line.
    -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Origo.ConsoleBridge" Version="$(OrigoShellPackageVersion)"/>
    </ItemGroup>

</Project>
