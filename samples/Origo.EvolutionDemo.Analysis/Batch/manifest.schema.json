{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Origo analysis batch manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "name",
    "metrics",
    "runs"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "protocol": {
      "type": "string"
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "number",
              "boolean"
            ]
          },
          "expression": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "anyOf": [
          {
            "required": [
              "path"
            ]
          },
          {
            "required": [
              "expression"
            ]
          }
        ],
        "not": {
          "required": [
            "path",
            "expression"
          ]
        }
      }
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "metrics",
          "labels"
        ],
        "properties": {
          "metrics": {
            "type": "string",
            "minLength": 1
          },
          "labels": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
