<Project Sdk="Microsoft.NET.Sdk">

    <!--
        Regression suite for the local, Godot-free Evolution Demo analysis tool.
        Like the other samples projects (including Origo.EvolutionDemo.Logic.Tests)
        it is intentionally outside Origo.sln and therefore CI-exempt: sample
        tooling is run explicitly by maintainers with the commands documented in
        samples/Origo.EvolutionDemo.Analysis/README.md.
    -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <RollForward>LatestMajor</RollForward>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <UseAppHost>true</UseAppHost>
        <RootNamespace>Origo.EvolutionDemo.Analysis.Tests</RootNamespace>
        <!-- Test method names use underscores by design; sample tooling is not a shipped API. -->
        <NoWarn>$(NoWarn);CA1707;CA1861;CA1859</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="xunit.runner.visualstudio">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Origo.EvolutionDemo.Analysis\Origo.EvolutionDemo.Analysis.csproj" />
        <ProjectReference Include="..\Origo.EvolutionDemo.Logic\Origo.EvolutionDemo.Logic.csproj" />
    </ItemGroup>

</Project>
